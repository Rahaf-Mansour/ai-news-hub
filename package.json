{
  "name": "ai-news-hub",
  "private": true,
  "version": "0.1.0",
  "description": "A daily, role-tagged AI news and learning hub read through five lenses (Claude, QA, product, full-stack, AI dev tools), with Claude release tracking.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "ingest": "tsx ingest/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p cypress/tsconfig.json",
    "cy:open": "cypress open",
    "cy:run": "start-server-and-test preview http://127.0.0.1:4173 \"cypress run\"",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build && npm run cy:run"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cheerio": "^1.2.0",
    "cypress": "^16.2.1",
    "domhandler": "^6.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "rss-parser": "^3.13.0",
    "start-server-and-test": "^3.0.13",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
